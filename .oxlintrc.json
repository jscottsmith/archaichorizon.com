{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["components/ui/**", "app/components/ui/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
